# Chime Long: every setting the site reads. Copy to .env.local for local work, and set the same names in Vercel
# (Project → Settings → Environment Variables) for production. Never commit real values.
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ---- required in production ----------------------------------------------------------------------------------

# Database (MongoDB Atlas). Inquiries, the admin panel's edits, subscribers, campaigns and the visitor log live here.
MONGODB_URI=
MONGODB_DB=chimelong

# The admin who signs in at /admin (there is no sign-up page).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs the panel's private requests to the site's own pages. Any long random string.
ADMIN_ENC_KEY=

# The public address, no trailing slash. Used in emails, unsubscribe links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Vercel calls /api/cron/daily with this; without it the daily job refuses to run (overdue alerts, retries, scheduled
# campaigns, subscriber re-scoring).
# It also sends the quote follow-ups: quotes unanswered after 3 days in the desk's digest, and the optional buyer nudge.
CRON_SECRET=

# ---- email (Resend) ------------------------------------------------------------------------------------------
# Until RESEND_API_KEY, INQUIRY_TO and INQUIRY_FROM are all set, nothing is emailed and campaigns can't be sent.
RESEND_API_KEY=
# The desk inbox(es) that receive inquiries; comma-separate several.
INQUIRY_TO=
# A sender on a domain verified in Resend, e.g. "Chime Long <inquiries@yourdomain.com>".
INQUIRY_FROM=
# Optional: a different sender for Marketing campaigns, e.g. "Chime Long <news@yourdomain.com>".
MARKETING_FROM=
# Optional: the Resend segment line-sheet signups also join.
RESEND_SEGMENT_ID=

# ---- marketing -----------------------------------------------------------------------------------------------
# Signs every campaign email's unsubscribe link (16+ characters). Campaigns are refused until it is set.
MARKETING_SECRET=
# Signs the one-click "mark replied" links in desk emails (16+ characters); also used for unsubscribe links if
# MARKETING_SECRET is not set.
# Also signs the links to each buyer's quote page (/q/CL-…) unless QUOTE_SECRET is set.
DESK_SECRET=
# Optional: a separate long random secret that signs the buyer quote page links. Defaults to DESK_SECRET.
QUOTE_SECRET=

# ---- visitor log ---------------------------------------------------------------------------------------------
# Secret behind the anonymous daily visit ids. Falls back to MONGODB_URI; set it so the two are separate.
VISIT_SALT=

# ---- form spam limits ----------------------------------------------------------------------------------------
# Nothing to set: the public forms are rate limited per visitor (src/lib/leads/ratelimit.ts), counted in MongoDB's
# rate_limits collection when MONGODB_URI is set and in memory otherwise. The "Demo mode" note on thank-you screens
# shows only outside production (VERCEL_ENV, or NODE_ENV when that is unset) while email isn't configured.

# ---- AI (Kai on the site, the AI agent and Vela in the panel) ------------------------------------------------
# One of these. Gemini direct (Google AI Studio)…
GOOGLE_GENERATIVE_AI_API_KEY=
ASSISTANT_GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# …or any model through the Vercel AI Gateway.
AI_GATEWAY_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_FALLBACKS=
# Daily and per-minute limits on model calls (defaults: 1000 per day).
ASSISTANT_RPD=
ASSISTANT_RPM=
ASSISTANT_TPD=

# ---- optional ------------------------------------------------------------------------------------------------
# Lets the admin panel read pages on a Vercel deployment that has Deployment Protection on.
VERCEL_AUTOMATION_BYPASS_SECRET=
